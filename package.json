{
  "name": "tetris-webgpu",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm --filter @tetris/web dev",
    "build": "pnpm --filter @tetris/web build",
    "test": "pnpm --filter @tetris/core test",
    "test:watch": "pnpm --filter @tetris/core test:watch",
    "typecheck": "tsc -p tsconfig.scripts.json && pnpm -r typecheck",
    "lint": "eslint .",
    "test:e2e": "pnpm --filter @tetris/web test:e2e",
    "check:docs": "tsx scripts/check-docs.ts",
    "check:styles": "tsx scripts/check-styles.ts",
    "check:claims": "tsx packages/evidence-layer/bin/check-claims.ts",
    "check:receipt": "tsx packages/evidence-layer/bin/check-receipt.ts",
    "check:all": "tsx scripts/governance.ts",
    "ci:summary": "tsx packages/evidence-layer/bin/ci-summary.ts",
    "evidence": "tsx scripts/gather-evidence.ts",
    "fingerprint": "tsx scripts/fingerprint.ts",
    "journal:report": "tsx packages/evidence-layer/bin/journal-report.ts",
    "journal:tag": "tsx packages/evidence-layer/bin/journal-tag.ts",
    "test:scripts": "pnpm --filter evidence-layer test && vitest run --config vitest.scripts.config.ts",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "evidence-layer": "workspace:*",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
